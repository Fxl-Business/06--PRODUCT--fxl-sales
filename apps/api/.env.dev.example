# apps/api/.env.dev.example
#
# Local dev defaults. After init-from-template (or setup-dev.sh) this is
# copied verbatim to apps/api/.env and the app reads from there.
#
# This file IS committed and contains only localhost defaults plus public Hub config.

NODE_ENV=development
PORT=3006
CORS_ORIGIN=http://localhost:8006

# Local Docker Postgres - host port matches docker-compose.yml mapping.
# Uses the project-number convention (5000 + project_number).
#
# Standard FXL single-role database URL.
# Staging/prod DBs are created by create-db.sh, which prints the value to paste here.
# Local Docker uses the postgres owner from docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5006/fxl_sales

# Optional admin DB override. Leave blank for the standard FXL single-role pattern.
ADMIN_DATABASE_URL=

# --- Auth: FXL Hub ---
# TWO forms, and setting BOTH stops the API booting with a message naming the
# offenders. FXL_HUB_CONFIG is this repo's documented form.
#
# Preferred: one JSON object with exactly these five keys, from the Hub admin panel.
#   {"apiUrl":"","environment":"development","clientId":"","clientSecret":"","audience":"app.fxl-sales"}
FXL_HUB_CONFIG=

# Discrete form. Leave every line here blank when FXL_HUB_CONFIG is set.
#
# ALL FIVE TOGETHER, OR NONE. The five are one Client credential, so a partial
# set is a misconfiguration and the API refuses to BOOT, naming the missing
# variable. With none of them set it boots and answers 503 hub_auth_not_configured
# to the sales-ops routes, which is what lets you work on the rest of the app
# before the Hub has issued you a Client.
#
# That is why the three known-good local values below ship COMMENTED rather than
# filled in: pre-filling three of five made every fresh clone a partial
# configuration. Uncomment them when you paste your client id and secret.
# FXL_HUB_API_URL=http://localhost:9016
FXL_HUB_API_URL=
# production | staging | development. Explicit, never inferred from NODE_ENV, and it
# must equal the environment segment inside the client id.
# FXL_HUB_ENVIRONMENT=development
FXL_HUB_ENVIRONMENT=
# pk_<slug>_<environment>_<random>, issued by the Hub admin panel.
FXL_HUB_CLIENT_ID=
# sk_<slug>_<environment>_<random>, shown ONCE by the Hub admin panel.
# Never commit a real value.
FXL_HUB_CLIENT_SECRET=
# app.<slug>, and it must equal app. plus the client id's slug. Configured, never derived.
# FXL_HUB_AUDIENCE=app.fxl-sales
FXL_HUB_AUDIENCE=

# Generated by the OPERATOR, not issued by the Hub. Required when
# FXL_HUB_ENVIRONMENT is not development.
FXL_HUB_HEALTH_TOKEN=

# THIS app's own origin plus /auth/callback, never the Hub's origin, and it must
# match a redirect_uri registered on the Client BYTE FOR BYTE.
#
# ALWAYS SET IT. There is no local default any more: an absent value resolves to
# ${FXL_HUB_API_URL}/auth/callback, which is the HUB's origin, and a callback on
# the Hub never returns to this app. Outside development that is refused at boot;
# in development it boots cleanly and fails at the login screen instead, which is
# why the value ships filled in here.
#
# The WEB origin (8006) and not the api one (3006): vite proxies /auth from 8006
# to the api on 3006, so the registered callback is the web origin.
FXL_HUB_REDIRECT_URI=http://localhost:8006/auth/callback
# Optional. Defaults to CORS_ORIGIN after a successful Hub callback; the error
# variant then defaults to that value with ?error=auth appended.
# SALES_ and not FXL_HUB_: this pair is resolved by this app alone and is not
# one of the nine names the Hub SDK resolves and validates itself.
SALES_POST_LOGIN_REDIRECT=
SALES_POST_LOGIN_ERROR_REDIRECT=

# Optional. Input keying material (>= 32 chars) for THIS app's own Hub BFF
# session sealer. NOT the SDK's FXL_HUB_SESSION_ENCRYPTION_KEY, which is a
# required strict-hex 32-byte key for a store this app does not use.
# Defaults to an HKDF-SHA256 derivation of FXL_HUB_CLIENT_SECRET, so it can stay blank.
# Changing this value (or FXL_HUB_CLIENT_SECRET) logs every user out.
SALES_SESSION_ENCRYPTION_IKM=

# Public origin used for generated referral links.
PUBLIC_LINK_BASE_URL=http://localhost:3006

# --- Observability: optional in dev ---
SENTRY_DSN=

# --- Email: not needed for dev ---
RESEND_API_KEY=
RESEND_FROM=
